# Copy to apps/web/.env.local for local development (optional; defaults work locally).
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time — never put secrets here.

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=https://qualti.io

# Optional public form endpoint for the landing-page lead form (Formspree, a future
# NestJS public lead route, or another HTTPS form endpoint).
NEXT_PUBLIC_LEAD_ENDPOINT=
