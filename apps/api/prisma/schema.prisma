generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  auditEvents AuditEvent[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  sites                Site[]
  inspectionTemplates  InspectionTemplate[]
  templateVersions     TemplateVersion[]
  templateSections     TemplateSection[]
  templateItems        TemplateItem[]
  auditEvents          AuditEvent[]
}

model Membership {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  role           Role   @default(INSPECTOR)

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, organizationId])
}

model Site {
  id             String @id @default(cuid())
  organizationId String
  name           String
  code           String?
  location       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@unique([id, organizationId])
}

model InspectionTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     TemplateVersion[]

  @@index([organizationId, updatedAt])
  @@unique([id, organizationId])
}

model TemplateVersion {
  id              String                @id @default(cuid())
  organizationId  String
  templateId      String
  draftTemplateId String?               @unique
  versionNumber   Int
  status          TemplateVersionStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template     InspectionTemplate @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sections     TemplateSection[]

  @@index([organizationId])
  @@index([templateId, status])
  @@unique([templateId, versionNumber])
  @@unique([id, organizationId])
}

model TemplateSection {
  id             String   @id @default(cuid())
  organizationId String
  versionId      String
  name           String
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version      TemplateVersion @relation(fields: [versionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  items        TemplateItem[]

  @@index([organizationId])
  @@index([versionId, sortOrder])
  @@unique([id, organizationId])
}

model TemplateItem {
  id             String           @id @default(cuid())
  organizationId String
  sectionId      String
  name           String
  type           TemplateItemType
  sortOrder      Int
  unit           String?
  minValue       Float?
  maxValue       Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  section      TemplateSection @relation(fields: [sectionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId])
  @@index([sectionId, sortOrder])
  @@unique([id, organizationId])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

enum Role {
  OWNER
  ADMIN
  REVIEWER
  INSPECTOR
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
}

enum TemplateItemType {
  PASS_FAIL
  TEXT
  NUMERIC
}