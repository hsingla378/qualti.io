# Copy to apps/api/.env for local development.

PORT=3001

# Matches docker-compose.yml (Postgres exposed on 5434 to avoid clashing with a local install).
DATABASE_URL=postgresql://qualti:qualti@localhost:5434/qualti_dev

# Signs auth tokens. Use a long random value outside local dev, e.g. `openssl rand -base64 48`.
# Falls back to an insecure dev default if unset — never deploy without it.
JWT_SECRET=change-me-local-dev-secret
JWT_EXPIRES_IN=7d

# Allowed CORS origin for the web app (cookies are sent cross-origin with credentials).
WEB_ORIGIN=http://localhost:3000
